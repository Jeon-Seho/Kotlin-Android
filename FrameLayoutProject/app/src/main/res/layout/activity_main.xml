<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:orientation="vertical"
        tools:context=".MainActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:text="FrameLayout 실습"
                android:textColor="#8BC34A"
                android:textSize="25sp"
                android:textStyle="bold|italic"/>
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:weightSum="4">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="visible">

                    <ImageView
                            android:id="@+id/imageViewBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="60dp"
                            android:scaleType="fitStart"
                            app:srcCompat="@drawable/body"/>

                    <ImageView
                            android:id="@+id/imageViewCrown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:scaleType="fitStart"
                            app:srcCompat="@drawable/crown1"/>

                    <ImageView
                            android:id="@+id/imageViewDress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="180dp"
                            android:scaleType="fitStart"
                            android:visibility="visible"
                            app:srcCompat="@drawable/dress1"/>

                    <ImageView
                            android:id="@+id/imageViewNecklace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="180dp"
                            android:scaleType="fitStart"
                            app:srcCompat="@drawable/necklace1"/>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                    <ImageView
                            android:id="@+id/imageViewCrown1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onClickChoice"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/crown1"/>

                    <ImageView
                            android:id="@+id/imageViewCrown2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onClickChoice"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/crown2"/>
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                    <ImageView
                            android:id="@+id/imageViewNeck1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onClickChoice"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/necklace1"/>

                    <ImageView
                            android:id="@+id/imageViewNeck2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:onClick="onClickChoice"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/necklace2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
            <ImageView
                    android:id="@+id/imageViewDress1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/dress1"/>
            <ImageView
                    android:id="@+id/imageViewDress2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    app:srcCompat="@drawable/dress2"/>

            <ImageView
                    android:id="@+id/imageViewDress3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    app:srcCompat="@drawable/dress3"/>
        </LinearLayout>
    </LinearLayout>

    <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00BCD4"
            android:onClick="onClickReset"
            android:text="다시하기"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold"/>
</LinearLayout>